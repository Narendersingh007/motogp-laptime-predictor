# Ignore local virtual environments
motogp-env/
.env/
venv/
*.venv

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore large/temporary data files specifically
# Keep train_sample.csv tracked!
data/train.csv
data/test.csv
data/val.csv
data/kaive's_output.csv

