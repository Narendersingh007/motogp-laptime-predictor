data/sampler.py

# Ignore large model files
models/*.joblib

# Ignore Jupyter notebook checkpoints
notebooks/.ipynb_checkpoints/

# Ignore OS / editor specific files
.DS_Store
.vscode/

# Ignore temporary/utility scripts in root
new.py
setup.py

# Ignore archives
*.zip
*.tar.gz

# --- Allow specific files ---
# Ensure the sample data for the app IS tracked
!data/train_sample.csv